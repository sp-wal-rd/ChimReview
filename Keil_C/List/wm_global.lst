  46          void wm_ProcessIrGesture(void)
  47          {
  48   1          if(wm_IrDelayCnt < 200) return;
  49   1          if(!wm_EnGestureProcessing) return;
  50   1          
  51   1          leftSensor = !P07;
  52   1          rightSensor = !P17;
  53   1          
  54   1          if((leftSensor || rightSensor) && (wm_IrGeastureTimeOutCnt > 500)) {
  55   2              // False geasture - reset swipe state
  56   2              wm_LeftSwipeInit = 0;
  57   2              wm_rightSwipeInit = 0;
  58   2              wm_IrGeastureTimeOutCnt = 0;
  59   2              return;
  60   2          }
  61   1          
  62   1          // Left swipe detection (right--left)
  63   1          if(leftSensor && wm_LeftSwipeInit) {
  64   2              // Complete left swipe - increment fan speed
  65   2              wm_LeftSwipeInit = 0;
  66   2              wm_rightSwipeInit = 0;
  67   2              wm_IrDelayCnt = 0;
  68   2      
  69   2                      if(wm_IsUiDisableRequested)
  70   2                      {
  71   3                              wm_IsUiDisableRequested = FALSE;                
  72   3                              wm_IsSleepModeRequested = FALSE;
  73   3                              TURN_ON_LED(LED_6);
C51 COMPILER V9.60.7.0   WM_GLOBAL                                                         05/16/2026 17:36:10 PAGE 104 

  74   3                      }
  75   2          
  76   2      
  77   2              if(++wm_FanSpeed > 9) wm_FanSpeed = 0;
  78   2              if((wm_FanSpeed == 1) && (!wm_UiBoardState) )
  79   2              {
  80   3                      wm_UiBoardState = TRUE;
  81   3                      wm_ReservedBitState = FALSE;
  82   3                      wm_TurnOnAllTKLed(300);
  83   3                      SET_LED_INC_MODE();
  84   3                      wm_KitchenLightState = TRUE;
  85   3                      wm_TurnOffAllTKLed();
  86   3              }
  87   2              if(!wm_FanSpeed) 
  88   2              {
  89   3                  wm_TurnOffFan();
  90   3              } 
  91   2              else 
  92   2              {
  93   3                 wm_FanState = TRUE;
  94   3                 SET_LED_INC_MODE();
  95   3                 wm_TurnOffAllTKLed();
  96   3                 TURN_ON_LED(LED_1);
  97   3      
  98   3              }
  99   2                      
 100   2              wm_DisplayDigit(wm_FanSpeed);
 101   2          }
 102   1          else if(leftSensor) {
 103   2              wm_rightSwipeInit = 1;
 104   2              wm_IrGeastureTimeOutCnt = 0;
 105   2          }
 106   1          
 107   1          // Right swipe detection (left--right)
 108   1          if(rightSensor && wm_rightSwipeInit) {
 109   2              // Complete right swipe - sleep request
 110   2              wm_LeftSwipeInit = 0;
 111   2              wm_rightSwipeInit = 0;
 112   2              wm_IrDelayCnt = 0;
 113   2              
 114   2                      if((!wm_IsSleepModeRequested)&& (wm_UiBoardState)) {
 115   3                  wm_IsSleepModeRequested = TRUE;
 116   3                  wm_GeneralCnt = 0;
 117   3                  wm_UiDisTimeOutCnt = WM_UI_DIS_TIMEOUT;
 118   3                  wm_IsUiDisableRequested = TRUE;
 119   3              }
 120   2              else if(wm_IsSleepModeRequested) {
 121   3                  // Double swipe within timeout - immediate sleep
 122   3                  wm_IsSleepModeRequested = FALSE;
 123   3                  wm_ShutdownUI();
 124   3                              wm_SleepFromGesture(100);
 125   3              }
 126   2          }
 127   1          else if(rightSensor) {
 128   2              wm_LeftSwipeInit = 1;
 129   2              wm_IrGeastureTimeOutCnt = 0;
 130   2          }
 131   1      }
