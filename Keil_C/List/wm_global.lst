 627      =4  /*macro function********************************************************/
 628      =4  /**
 629      =4   * @brief  ADC interrupt initialization.
 630      =4   * @param  NewState[in]:Enable/Disable ADC Interrupt.
 631      =4   *                     - DISABLE:Disable ADC interrupt.
 632      =4   *                     - ENABLE:Enable ADC interrupt.
 633      =4   * @param  Priority[in]:Select interrupt priority.
 634      =4   *                     - LOW:low priority.
 635      =4   *                     - HIGH:high priority.
 636      =4   */
 637      =4  #define ADC_ITConfig(NewState,Priority)                                                                         \
 638      =4                                          do{                                                                                                                                                                             \
 639      =4                                                          EADC = (bit)NewState;                                                                                           \
 640      =4                                                          IPADC = (bit)Priority;                                                                                  \
 641      =4                                          }while(0)
 642      =4  
 643      =4   /**
 644      =4   * @brief  Start an AD conversion.
 645      =4   * @param  None
 646      =4   * @retval None
 647      =4   */                  
 648      =4  #define ADC_StartConversion() SET_BIT(ADCCON,0X40)
