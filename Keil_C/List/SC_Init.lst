 627      =3  /*macro function********************************************************/
 628      =3  /**
 629      =3   * @brief  ADC interrupt initialization.
 630      =3   * @param  NewState[in]:Enable/Disable ADC Interrupt.
 631      =3   *                     - DISABLE:Disable ADC interrupt.
 632      =3   *                     - ENABLE:Enable ADC interrupt.
 633      =3   * @param  Priority[in]:Select interrupt priority.
 634      =3   *                     - LOW:low priority.
 635      =3   *                     - HIGH:high priority.
 636      =3   */
 637      =3  #define ADC_ITConfig(NewState,Priority)                                                                         \
 638      =3                                          do{                                                                                                                                                                             \
 639      =3                                                          EADC = (bit)NewState;                                                                                           \
 640      =3                                                          IPADC = (bit)Priority;                                                                                  \
 641      =3                                          }while(0)
 642      =3  
 643      =3   /**
 644      =3   * @brief  Start an AD conversion.
 645      =3   * @param  None
 646      =3   * @retval None
 647      =3   */                  
 648      =3  #define ADC_StartConversion() SET_BIT(ADCCON,0X40)
 649      =3  
 650      =3  #if defined(SC93F833x) || defined(SC93F843x) || defined(SC93F743x)
