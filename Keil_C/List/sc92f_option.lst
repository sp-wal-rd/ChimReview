  55            /**
  56            * @brief  Enables or disables the WDT peripheral.
  57            * @param  NewState[in]:  new state of the WDT peripheral.
  58            *                  - DISABLE:Function disable
  59            *                  - ENABLE:Function enable 
  60            * @retval None
  61            */
  62          void OPTION_WDT_Cmd(FunctionalState NewState)
  63          {
  64   1        OPINX = 0XC1;
  65   1      
  66   1        if(NewState == DISABLE)
  67   1        {
  68   2          OPREG &= 0X7F;
  69   2        }
  70   1        else
  71   1        {
  72   2          OPREG |= 0X80;
  73   2        } 
  74   1      }
  75          
