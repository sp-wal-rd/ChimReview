  90          /**
  91           * @brief  WDT function switch function
  92           * @param  NewState[in]:Function Enable/disable selection   
  93           *              - DISABLE: disable    
  94           *              - ENABLE:Enable    
  95           * @retval None
  96           */
  97          void WDT_Cmd(FunctionalState NewState)
  98          {
  99   1        OPINX = 0XC1;
 100   1      
 101   1        if(NewState == DISABLE)
 102   1        {
 103   2          OPREG &= 0X7F;
 104   2        }
 105   1        else
 106   1        {
 107   2          OPREG |= 0X80;
 108   2        }
 109   1      }
