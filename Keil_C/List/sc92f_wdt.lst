  79           *          - WDT_OverflowTime_7_88MS:Settings 7.88MS
  80           *          - WDT_OverflowTime_3_94MS:Settings 3.94MS
  81           * @retval None
  82           */
  83          void WDT_Init(WDT_OverflowTime_TypeDef
  84                        OverflowTime)
  85          {
  86   1        WDTCON = (WDTCON & 0XF8) | OverflowTime;
  87   1      }
